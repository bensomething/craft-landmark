{
    "name": "bensomething/craft-landmark",
    "description": "A field for drawing markers, lines and shapes on a map, stored as GeoJSON.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "plugin",
        "field",
        "map",
        "maps",
        "leaflet",
        "geojson",
        "geometry"
    ],
    "support": {
        "issues": "https://github.com/bensomething/craft-landmark/issues",
        "source": "https://github.com/bensomething/craft-landmark"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.10"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "bensomething\\landmark\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "bensomething\\landmark\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "landmark",
        "name": "Landmark",
        "developer": "Ben Smith",
        "developerUrl": "https://bensomething.com",
        "documentationUrl": "https://github.com/bensomething/craft-landmark",
        "changelogUrl": "https://raw.githubusercontent.com/bensomething/craft-landmark/develop/CHANGELOG.md",
        "class": "bensomething\\landmark\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "phpunit"
    }
}
