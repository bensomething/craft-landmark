{% extends '_layouts/cp' %}

{% set title = 'Map'|t('landmark') %}

{% block actionButton %}
    {% if field %}
        {{ disclosureMenu(fields|map(f => {
            label: f.name,
            url: cpUrl('landmark', { field: f.handle }),
            selected: f.id == field.id,
        }), {
            buttonLabel: field.name,
            buttonAttributes: { class: ['btn', 'menubtn'] },
            hiddenLabel: 'Field'|t('landmark'),
        }) }}
    {% endif %}
{% endblock %}

{% block content %}
    {% if config %}
        <div id="landmark-overview" class="landmark-overview">
            <div class="landmark-map"></div>
        </div>
    {% else %}
        <p>{{ 'Turn on the overview map in the <a href="{url}">plugin settings</a>, and give a Landmark field some Show Shapes From sources for it to show.'|t('landmark', { url: cpUrl('settings/plugins/landmark') })|raw }}</p>
    {% endif %}
{% endblock %}
