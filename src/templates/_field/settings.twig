{% import "_includes/forms.twig" as forms %}

{# Labelled with the handle too: a field can be renamed per layout, and two can share a handle #}
{% set relationFieldOptions = [] %}
{% for type in ['craft\\fields\\Entries', 'craft\\fields\\Categories'] %}
    {% for f in craft.app.fields.getFieldsByType(type) %}
        {% set relationFieldOptions = relationFieldOptions|merge([{ label: f.name ~ ' (' ~ f.handle ~ ')', value: f.uid }]) %}
    {% endfor %}
{% endfor %}
{% set relationFieldOptions = relationFieldOptions|sort((a, b) => a.label <=> b.label) %}

{{ forms.checkboxGroupField({
    label: 'Tools'|t('landmark'),
    instructions: 'What can be drawn in this field.'|t('landmark'),
    id: 'shapes',
    name: 'shapes',
    values: field.shapes,
    options: [
        { label: 'Marker'|t('landmark'), value: 'marker' },
        { label: 'Line'|t('landmark'), value: 'line' },
        { label: 'Shape'|t('landmark'), value: 'polygon' },
    ],
    required: true,
}) }}

{{ forms.lightswitchField({
    label: 'Allow More Than One'|t('landmark'),
    instructions: 'Save several shapes together, as a multi-part geometry.'|t('landmark'),
    id: 'allowMultiple',
    name: 'allowMultiple',
    on: field.allowMultiple,
}) }}

{{ forms.textField({
    label: 'Default Latitude'|t('landmark'),
    instructions: 'Where this field’s map opens, before anything is drawn. Leave blank to use the plugin’s setting.'|t('landmark'),
    id: 'defaultLat',
    name: 'defaultLat',
    value: field.defaultLat,
    size: 12,
}) }}

{{ forms.textField({
    label: 'Default Longitude'|t('landmark'),
    id: 'defaultLng',
    name: 'defaultLng',
    value: field.defaultLng,
    size: 12,
}) }}

{{ forms.textField({
    label: 'Default Zoom'|t('landmark'),
    id: 'defaultZoom',
    name: 'defaultZoom',
    value: field.defaultZoom,
    type: 'number',
    size: 4,
}) }}

<hr>

{% set sourceRows %}
    {# Posts an empty value when nothing is ticked, so the setting can be cleared #}
    {{ hiddenInput('contextFields', '') }}
    <div class="flex flex-col gap-s">
        {% for option in sourceOptions %}
            <div class="flex flex-nowrap items-center gap-s">
                <div class="flex-grow">
                    {{ forms.checkbox({
                        label: option.label,
                        name: 'contextFields[]',
                        value: option.value,
                        checked: option.value in field.contextFields,
                    }) }}
                </div>
                {{ forms.color({
                    id: 'contextColour' ~ loop.index,
                    name: 'contextColours[' ~ option.value ~ ']',
                    value: field.contextColours[option.value] ?? '',
                    small: true,
                }) }}
            </div>
        {% endfor %}
    </div>
{% endset %}

{{ forms.field({
    label: 'Show Shapes From'|t('landmark'),
    instructions: 'Other entries\' shapes are drawn behind this field\'s own, so you can line things up. They can\'t be edited here. A section picked on its own gets its own toggle, and is left out of the whole field\'s. Leave a colour blank to have one picked.'|t('landmark'),
    id: 'contextFields',
}, sourceRows) }}

{{ forms.checkboxGroupField({
    label: 'Only From Entries Sharing'|t('landmark'),
    instructions: 'Relations entries can share, so a field only shows shapes from entries related to the same thing. Tick one for each entry type this field is on, and each entry uses whichever its own layout has. Leave all unticked to show every shape.'|t('landmark'),
    id: 'contextRelations',
    name: 'contextRelations',
    values: field.contextRelations,
    options: relationFieldOptions,
}) }}

{{ forms.textField({
    label: 'Most Shapes To Show'|t('landmark'),
    id: 'contextLimit',
    name: 'contextLimit',
    value: field.contextLimit,
    type: 'number',
    size: 5,
}) }}

<hr>

{{ forms.textField({
    label: 'Map Height'|t('landmark'),
    instructions: 'In pixels. Leave blank to use the plugin’s setting.'|t('landmark'),
    id: 'height',
    name: 'height',
    value: field.height,
    type: 'number',
    size: 5,
    unit: 'px'|t('landmark'),
}) }}
