{% import "_includes/forms.twig" as forms %}

{% set landmarkFieldOptions = [] %}
{% for f in craft.app.fields.getFieldsByType('bensomething\\landmark\\fields\\Map') %}
    {% set landmarkFieldOptions = landmarkFieldOptions|merge([{ label: f.name ~ ' (' ~ f.handle ~ ')', value: f.uid }]) %}
{% endfor %}

{# Labelled with the handle too: a field can be renamed per layout, and two can share a handle #}
{% set relationFieldOptions = [{ label: 'None'|t('landmark'), value: '' }] %}
{% for type in ['craft\\fields\\Entries', 'craft\\fields\\Categories'] %}
    {% for f in craft.app.fields.getFieldsByType(type) %}
        {% set relationFieldOptions = relationFieldOptions|merge([{ label: f.name ~ ' (' ~ f.handle ~ ')', value: f.uid }]) %}
    {% endfor %}
{% endfor %}
{% set relationFieldOptions = relationFieldOptions|sort((a, b) => a.label <=> b.label) %}

{{ forms.checkboxGroupField({
    label: 'Tools'|t('landmark'),
    instructions: 'What can be drawn in this field.'|t('landmark'),
    id: 'shapes',
    name: 'shapes',
    values: field.shapes,
    options: [
        { label: 'Marker'|t('landmark'), value: 'marker' },
        { label: 'Line'|t('landmark'), value: 'line' },
        { label: 'Shape'|t('landmark'), value: 'polygon' },
    ],
    required: true,
}) }}

{{ forms.lightswitchField({
    label: 'Allow More Than One'|t('landmark'),
    instructions: 'Save several shapes together, as a multi-part geometry.'|t('landmark'),
    id: 'allowMultiple',
    name: 'allowMultiple',
    on: field.allowMultiple,
}) }}

{{ forms.textField({
    label: 'Default Latitude'|t('landmark'),
    instructions: 'Where this field’s map opens, before anything is drawn. Leave blank to use the plugin’s setting.'|t('landmark'),
    id: 'defaultLat',
    name: 'defaultLat',
    value: field.defaultLat,
    size: 12,
}) }}

{{ forms.textField({
    label: 'Default Longitude'|t('landmark'),
    id: 'defaultLng',
    name: 'defaultLng',
    value: field.defaultLng,
    size: 12,
}) }}

{{ forms.textField({
    label: 'Default Zoom'|t('landmark'),
    id: 'defaultZoom',
    name: 'defaultZoom',
    value: field.defaultZoom,
    type: 'number',
    size: 4,
}) }}

<hr>

{{ forms.checkboxGroupField({
    label: 'Show Shapes From'|t('landmark'),
    instructions: 'Other entries\' shapes are drawn behind this field\'s own, so you can line things up. They can\'t be edited here.'|t('landmark'),
    id: 'contextFields',
    name: 'contextFields',
    values: field.contextFields,
    options: landmarkFieldOptions,
}) }}

{{ forms.selectField({
    label: 'Only From Entries Sharing'|t('landmark'),
    instructions: 'A relation both entries have, so a field only shows shapes from entries related to the same thing. Leave blank to show them all.'|t('landmark'),
    id: 'contextRelation',
    name: 'contextRelation',
    value: field.contextRelation,
    options: relationFieldOptions,
}) }}

{{ forms.textField({
    label: 'Most Shapes To Show'|t('landmark'),
    id: 'contextLimit',
    name: 'contextLimit',
    value: field.contextLimit,
    type: 'number',
    size: 5,
}) }}

<hr>

{{ forms.textField({
    label: 'Map Height'|t('landmark'),
    instructions: 'In pixels. Leave blank to use the plugin’s setting.'|t('landmark'),
    id: 'height',
    name: 'height',
    value: field.height,
    type: 'number',
    size: 5,
    unit: 'px'|t('landmark'),
}) }}
